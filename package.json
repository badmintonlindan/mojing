{
  "name": "mojing",
  "version": "0.1.1",
  "private": true,
  "description": "墨径 · 离线阅读与知识整理工作台",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/copy-pdf-assets.mjs && node scripts/licenses.mjs && node scripts/licenses-android.mjs --verify-existing",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test tests/knowledge.spec.ts tests/reader.spec.ts tests/layout-library.spec.ts",
    "test:tablet": "playwright test tests/sidebar.spec.ts tests/reader-zoom.spec.ts",
    "desktop": "electron .",
    "package:windows": "node scripts/licenses.mjs --require-electron && node scripts/licenses-android.mjs --verify-existing && node scripts/package-windows.mjs",
    "android:sync": "npm run build && cap sync android",
    "package:source": "node scripts/package-source.mjs",
    "preview": "node scripts/serve.mjs",
    "test:windows": "playwright test tests/electron.spec.ts",
    "test:roundtrip": "playwright test tests/roundtrip.spec.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "fflate": "^0.8.3",
    "lucide-react": "^1.67.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
